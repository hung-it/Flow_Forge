POSTGRES_USER=flowforge
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=flowforge
RABBITMQ_DEFAULT_USER=flowforge
RABBITMQ_DEFAULT_PASS=local-development-only
FLOWFORGE_DATABASE_URL=postgresql+asyncpg://flowforge:local-development-only@postgres:5432/flowforge
FLOWFORGE_RABBITMQ_URL=amqp://flowforge:local-development-only@rabbitmq:5672/
FLOWFORGE_JWT_SECRET=
FLOWFORGE_COOKIE_SECURE=false
FLOWFORGE_ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:5173","http://127.0.0.1:8000","http://127.0.0.1:5173"]
